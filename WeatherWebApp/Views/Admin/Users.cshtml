@model List<WeatherWebApp.Models.UserListViewModel>
@{
    ViewData["Title"] = "Utilizadores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Utilizadores</h2>
    <a asp-action="Create" class="btn btn-success">+ Novo Utilizador</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Role</th>
                <th>Criado em</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Username</td>
                    <td>@u.Role</td>
                    <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>