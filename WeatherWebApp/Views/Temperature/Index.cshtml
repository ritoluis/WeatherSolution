@using WeatherWebApp.Extensions
@model WeatherWebApp.Models.TemperatureViewModel
@{
    ViewData["Title"] = "Temperatura";
}

<h2 class="mb-4">Consulta de Temperatura</h2>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label">Escolher data</label>
            <input type="date" name="date" class="form-control"
                   value="@(Model.Date != default ? Model.Date.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Consultar</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">Dia Anterior</a>
        </div>
    </div>
</form>

@if (Model.AverageTemperature.HasValue)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5>@Model.Date.ToString("yyyy-MM-dd")</h5>
            <p class="mb-0"><strong>@Model.AverageTemperature °C</strong></p>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

@if (Model.IsAdmin && Model.Queries.Any())
{
    <hr />
    <h3>Auditoria — Consultas dos Utilizadores</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Utilizador</th>
                <th>Role</th>
                <th>Data</th>
                <th>Endpoint</th>
                <th>Data Alvo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var q in Model.Queries)
            {
                <tr>
                    <td>@q.Username</td>
                    <td>@q.Role</td>
                    <td>@q.QueryDate.ToLocalString()</td>
                    <td>@q.Endpoint</td>
                    <td>@q.TargetDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}